{
  "name": "@mrbrunowolff/minimal-typescript-native",
  "version": "1.0.0",
  "description": "Minimal TypeScript 7 starter with Bun, native tsc, oxlint, oxfmt, and JSX support",
  "keywords": [
    "bun",
    "jsx",
    "minimal",
    "oxfmt",
    "oxlint",
    "starter",
    "template",
    "tsc",
    "tsx",
    "typescript",
    "vanilla"
  ],
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrBrunoWolff/minimal-typescript-native.git"
  },
  "bin": {
    "create": "bin/create-ts-native-app.js"
  },
  "files": [
    "bin",
    "src",
    "public",
    "tests",
    "server.ts",
    "happydom.ts",
    "bunfig.toml",
    "tsconfig.json",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun --hot server.ts",
    "build": "bun build ./public/index.html --outdir=dist --minify",
    "test": "bun test --parallel",
    "test:watch": "bun test --watch",
    "typecheck": "tsc",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "check": "bun run --parallel --no-exit-on-error typecheck lint fmt:check",
    "audit": "bun audit --audit-level=high"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.5",
    "@types/bun": "1.4.2",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "packageManager": "bun@1.4.0"
}
