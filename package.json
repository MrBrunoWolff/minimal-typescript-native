{
  "name": "minimal-typescript-native",
  "version": "1.0.0",
  "description": "Minimal TypeScript Native starter-kit with Bun, tsgo, oxlint, oxfmt, and JSX support",
  "keywords": [
    "bun",
    "jsx",
    "minimal",
    "oxfmt",
    "oxlint",
    "starter",
    "template",
    "tsgo",
    "tsx",
    "typescript",
    "vanilla"
  ],
  "license": "MIT",
  "author": "",
  "bin": {
    "create": "bin/create-ts-native-app.js"
  },
  "files": [
    "bin",
    "src",
    "public",
    "tests",
    "server.ts",
    "happydom.ts",
    "bunfig.toml",
    "tsconfig.json",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun --hot server.ts",
    "build": "bun build ./public/index.html --outdir=dist --minify",
    "test": "bun test --parallel",
    "test:watch": "bun test --watch",
    "typecheck": "tsgo",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "check": "bun run --parallel --no-exit-on-error typecheck lint fmt:check",
    "audit": "bun audit --audit-level=high"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.2",
    "@types/bun": "1.3.14",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "packageManager": "bun@1.4.0"
}
